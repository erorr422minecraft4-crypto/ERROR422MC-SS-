local Players = game:GetService("Players")
local player = Players.LocalPlayer

local function addParticles(character)
	local head = character:WaitForChild("Head")

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxassetid://127476787"
	emitter.Rate = 500
	emitter.Speed = NumberRange.new(10)
	emitter.Lifetime = NumberRange.new(5)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Parent = head
end

if player.Character then
	addParticles(player.Character)
end

player.CharacterAdded:Connect(addParticles)
